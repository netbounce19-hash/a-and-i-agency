# ─────────────────────────────────────────────────────────────
# Contact form delivery — /app/api/contact/route.ts
# Configure ONE of the two channels. Resend wins if both are set.
# Copy to .env.local for dev, and add the same vars in
# Vercel → Project → Settings → Environment Variables for prod.
# Without either, the form returns 502 and the lead is only logged.
# ─────────────────────────────────────────────────────────────

# ── Option A: email via Resend (resend.com — free tier is enough) ──
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=hello@your-domain.com
# Must be a domain verified in Resend. Omit to use their test sender.
CONTACT_FROM_EMAIL=A-AND-I Site <noreply@your-domain.com>

# ── Option B: Telegram bot (instant push to your phone) ──
# Create via @BotFather, get the chat id from @userinfobot
# TELEGRAM_BOT_TOKEN=123456:AAG...
# TELEGRAM_CHAT_ID=123456789
